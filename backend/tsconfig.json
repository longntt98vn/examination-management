{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/node12/tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "outDir": "./dist",
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/"
  ]
}
